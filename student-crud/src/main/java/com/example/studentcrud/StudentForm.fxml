<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" spacing="10.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.studentcrud.StudentFormController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <HBox prefHeight="100.0" prefWidth="200.0">
         <children>
            <Label fx:id="RollTextField" maxWidth="-Infinity" prefHeight="19.0" prefWidth="30.0" style="-fx-background-color: #063970;" text="Roll" textAlignment="CENTER" textFill="WHITE">
               <opaqueInsets>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </opaqueInsets>
               <HBox.margin>
                  <Insets left="40.0" top="40.0" />
               </HBox.margin>
            </Label>
            <TextField alignment="CENTER" prefHeight="0.0" prefWidth="200.0" promptText="roll">
               <HBox.margin>
                  <Insets left="20.0" top="38.0" />
               </HBox.margin>
            </TextField>
         </children>
      </HBox>
      <HBox prefHeight="100.0" prefWidth="200.0">
         <children>
            <Label fx:id="NameTextField" prefHeight="18.0" prefWidth="39.0" style="-fx-background-color: #063970;" text="Name" textFill="WHITE">
               <HBox.margin>
                  <Insets left="40.0" top="40.0" />
               </HBox.margin>
            </Label>
            <TextField alignment="CENTER" prefHeight="0.0" prefWidth="200.0" promptText="name">
               <HBox.margin>
                  <Insets left="20.0" top="38.0" />
               </HBox.margin>
            </TextField>
         </children>
      </HBox>
      <Button fx:id="saveButton" defaultButton="true" mnemonicParsing="false" onAction="#handleSave" prefHeight="44.0" prefWidth="576.0" style="-fx-background-color: #063970;" text="Save" textAlignment="CENTER" textFill="WHITE" />
   </children>
</VBox>
